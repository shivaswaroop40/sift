# Required for real scoring and summaries. Without it, `npm run ingest:dry` still works.
ANTHROPIC_API_KEY=
# Optional. Point the SDK at an Anthropic-compatible gateway instead of api.anthropic.com.
# OpenCode Zen: ANTHROPIC_BASE_URL=https://opencode.ai/zen/v1 with your Zen key in ANTHROPIC_API_KEY.
ANTHROPIC_BASE_URL=
# Public URL of the deployed site, used for absolute links in RSS. Optional locally.
SITE_URL=https://sift.example.com

# --- Alternative: OpenCode Zen / Go open models, or any OpenAI-style server ---
# SIFT_PROVIDER=chat        for /v1/chat/completions models (MiniMax, GLM, Kimi, DeepSeek, Qwen)
# SIFT_PROVIDER=responses   for /v1/responses models (Muse Spark, GPT, Grok)
# SIFT_MODEL=minimax-m3
# OPENAI_API_KEY=<your Zen or Go key>
# OPENAI_BASE_URL=https://opencode.ai/zen/v1      Zen pay-as-you-go keys
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1   Go subscription keys (note the /go)
