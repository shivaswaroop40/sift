# Required for real scoring and summaries. Without it, `npm run ingest:dry` still works.
ANTHROPIC_API_KEY=
# Optional. Point the SDK at an Anthropic-compatible gateway instead of api.anthropic.com.
# OpenCode Zen: ANTHROPIC_BASE_URL=https://opencode.ai/zen/v1 with your Zen key in ANTHROPIC_API_KEY.
ANTHROPIC_BASE_URL=
# Public URL of the deployed site, used for absolute links in RSS. Optional locally.
SITE_URL=https://sift.example.com
