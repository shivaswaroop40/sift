---
import Base from '../layouts/Base.astro';
import Fields from '../components/Fields.astro';
import { SITE } from '../../site.config';
import { DOMAINS, editionsFor, fmtDate } from '../lib/domains';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const newest = (await Promise.all(DOMAINS.map(async (d) => (await editionsFor(d.slug))[0]?.[0] ?? ''))).sort().at(-1);
---
<Base title={`${SITE.name}. ${SITE.tagline}`} edition={['Every field', `${DOMAINS.length} fields`, ...(newest ? [`Updated ${fmtDate(newest)}`] : [])]}>
  <script is:inline set:html={`try{var d=localStorage.getItem('sift-domain');if(d&&!location.hash){location.replace('${base}/'+d+'/');}}catch(e){}`}></script>
  <Fields />
</Base>
