---
import Base from '../layouts/Base.astro';
import { SITE } from '../../site.config';
import { DOMAINS, editionsFor } from '../lib/domains';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = await Promise.all(DOMAINS.map(async (d) => [d.slug, (await editionsFor(d.slug))[0]?.[0] ?? null] as const));
const latestMap = Object.fromEntries(latest);
---
<Base title={`${SITE.name}. ${SITE.tagline}`}>
  <script is:inline set:html={`(function(){try{var d=localStorage.getItem('sift-domain');if(d&&!location.hash){location.replace('${base}/'+d+'/');}}catch(e){}})();`}></script>
  <div class="prose">
    <h1>{SITE.tagline}</h1>
    <p>{SITE.description}</p>
    <p>Pick a field. The site remembers your choice and opens there next time.</p>
  </div>
  <div class="domains">
    {DOMAINS.map((d) => (
      <a href={`${base}/${d.slug}/`} style={`--card-accent:${d.accent}`}>
        <b>{d.name}</b>
        <span>{d.short}{latestMap[d.slug] ? ` · latest ${latestMap[d.slug]}` : ' · no editions yet'}</span>
      </a>
    ))}
  </div>
</Base>
