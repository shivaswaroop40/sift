---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../../site.config';
import { DOMAINS, editionsFor, fmtDate } from '../../lib/domains';

export async function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: d.slug }, props: { domain: d } }));
}
const { domain } = Astro.props;
const editions = await editionsFor(domain.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${SITE.name} · ${domain.name} archive`} domain={domain} current="archive">
  <section class="section">
    <p class="kicker">Archive <span>· {editions.length} {editions.length === 1 ? 'edition' : 'editions'}</span></p>
    <h2 class="section-title">{domain.name}</h2>
    <ul class="row-list">
      {editions.map(([date, stories]) => (
        <li>
          <div>
            <strong><a href={`${base}/${domain.slug}/${date}/`}>{fmtDate(date)}</a></strong>
            <span class="sub">{stories.length} stories · {stories[0]?.data.title}</span>
          </div>
          <span class="when">{date}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
