---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../../site.config';
import { DOMAINS, editionsFor, fmtDate } from '../../lib/domains';

export async function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: d.slug }, props: { domain: d } }));
}
const { domain } = Astro.props;
const editions = await editionsFor(domain.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const count = `${editions.length} ${editions.length === 1 ? 'edition' : 'editions'}`;
const oldest = editions.at(-1)?.[0];
---
<Base title={`${SITE.name} · ${domain.name} archive`} domain={domain} current="archive" edition={[`${domain.name} archive`, count, ...(oldest ? [`Since ${fmtDate(oldest)}`] : [])]}>
  <section class="listing" aria-labelledby="archive-head">
    <h2 class="section-head" id="archive-head">Every {domain.name.toLowerCase()} edition</h2>
    <ul class="rows">
      {editions.map(([date, stories]) => (
        <li>
          <div>
            <p class="row-title"><a href={`${base}/${domain.slug}/${date}/`}>{fmtDate(date)}</a></p>
            <p class="sub">{stories.length} stories · Leading: {stories[0]?.data.title}</p>
          </div>
          <span class="when">{date}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
