---
import Base from '../../layouts/Base.astro';
import Edition from '../../components/Edition.astro';
import Fields from '../../components/Fields.astro';
import { SITE } from '../../../site.config';
import { DOMAINS, editionsFor, fmtDate } from '../../lib/domains';

export async function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: d.slug }, props: { domain: d } }));
}
const { domain } = Astro.props;
const editions = await editionsFor(domain.slug);
const [date, stories] = editions[0] ?? [null, []];
const edition = date ? [`${domain.name} edition`, fmtDate(date), `${stories.length} stories kept`] : [`${domain.name} edition`];
---
<Base title={`${SITE.name} · ${domain.name}`} description={`${domain.short}. ${SITE.description}`} domain={domain} current="latest" edition={edition}>
  {date ? (
    <Edition domain={domain} date={date} stories={stories} />
  ) : (
    <div class="prose listing"><p>No editions yet. Run <code>npm run ingest -- --domain {domain.slug}</code> to build the first one.</p></div>
  )}
  <Fields exclude={domain} />
</Base>
