---
import Base from '../layouts/Base.astro';
import { SITE } from '../../site.config';
import { DOMAINS } from '../lib/domains';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = String(Astro.site ?? '').replace(/\/$/, '');
---
<Base title={`About ${SITE.name}`} current="about">
  <section class="section">
    <p class="kicker">About</p>
    <div class="prose">
      <p>{SITE.description}</p>
      <p>Every morning a script reads the feeds below, drops anything it has seen before, and asks a language model to score each new item for depth, novelty and usefulness to a specific reader. The top dozen get a short summary and a line on why the original is worth opening. Everything links out. The model can be wrong, so read the source before you repeat a claim.</p>
    </div>
  </section>
  <section class="section">
    <p class="kicker">Subscribe</p>
    <p class="section-note">One RSS feed per field. Works with NetNewsWire, Reeder, Feedly and any other reader, and gives you an iPhone home screen widget for free. Or open a field in Safari and use Share, then Add to Home Screen.</p>
    <ul class="arrow-list">
      {DOMAINS.map((d) => <li><a href={`${base}/${d.slug}/rss.xml`}>{d.name}</a> <code>{`${site}${base}/${d.slug}/rss.xml`}</code></li>)}
    </ul>
  </section>
  {DOMAINS.map((d) => (
    <section class="section">
      <p class="kicker">{d.name} <span>· {d.feeds.length} sources</span></p>
      <ul class="row-list">
        {d.feeds.map((f) => (
          <li><strong><a href={f.url}>{f.name}</a></strong><span class="when">{f.kind}</span></li>
        ))}
      </ul>
    </section>
  ))}
</Base>
