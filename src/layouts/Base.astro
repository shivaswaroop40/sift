---
import '../styles/global.css';
import { SITE } from '../../site.config';
import { DOMAINS, type Domain } from '../lib/domains';

interface Props {
  title: string;
  description?: string;
  domain?: Domain;
  current?: 'latest' | 'archive' | 'about';
  edition?: string[];
}
const { title, description = SITE.description, domain, current, edition = [] } = Astro.props;
const [editionHead, ...editionLines] = edition;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rssHref = domain ? `${base}/${domain.slug}/rss.xml` : null;
const links = [
  ...(domain
    ? [
        { href: `${base}/${domain.slug}/archive/`, label: 'Archive', key: 'archive' },
        { href: rssHref!, label: 'RSS', key: 'rss' },
        { href: `${base}/${domain.slug}/latest.json`, label: 'JSON', key: 'json' },
      ]
    : []),
  { href: `${base}/about/`, label: 'About', key: 'about' },
];
---
<!doctype html>
<html lang="en" data-domain={domain?.slug ?? ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1258" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FFE03A" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={domain ? `${SITE.name} ${domain.name}` : SITE.name} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="icon" href={`${base}/icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/icons/apple-touch-icon.png`} />
    {rssHref && <link rel="alternate" type="application/rss+xml" title={`${SITE.name} ${domain!.name}`} href={rssHref} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Funnel+Sans:ital,wght@0,400;0,600;0,800;1,400&family=Kalnia:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Same rule as shivu.io: saved theme, else system. Applied before paint. Remember the domain for the home redirect.
      try {
        var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
        var d = document.documentElement.dataset.domain;
        if (d) localStorage.setItem('sift-domain', d);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page">
      <nav class="topnav" aria-label="Fields">
        <ul class="tabs">
          {DOMAINS.map((d) => (
            <li>
              <a href={`${base}/${d.slug}/`} class:list={{ active: d.slug === domain?.slug }} aria-current={d.slug === domain?.slug && current === 'latest' ? 'page' : undefined}>{d.name}</a>
            </li>
          ))}
        </ul>
        <ul class="links">
          {links.map((l) => (
            <li><a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li>
            <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
              <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
          </li>
        </ul>
      </nav>

      <header class="masthead">
        <div>
          <h1 class="masthead-name"><a href={`${base}/`}>{SITE.name}</a></h1>
          <p class="masthead-tagline">{SITE.tagline}</p>
        </div>
        {editionHead && (
          <div class="edition-line">
            <p class="edition-head">{editionHead}</p>
            {editionLines.map((l) => <p>{l}</p>)}
          </div>
        )}
      </header>

      <main id="content">
        <slot />
      </main>

      <footer class="footer">
        <p>Sift is open source. Add a field by adding one JSON file.</p>
        <p><a href="https://github.com/shivaswaroop40/sift">github.com/shivaswaroop40/sift</a></p>
        <p class="colophon">Scored and summarised by a language model from public feeds. Everything links out. Nothing here is original reporting.</p>
      </footer>
    </div>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
