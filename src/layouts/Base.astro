---
import '../styles/global.css';
import { SITE } from '../../site.config';
import { DOMAINS, type Domain } from '../lib/domains';

interface Props {
  title: string;
  description?: string;
  domain?: Domain;
  current?: 'latest' | 'archive' | 'about';
}
const { title, description = SITE.description, domain, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rssHref = domain ? `${base}/${domain.slug}/rss.xml` : null;
const nav = domain
  ? [
      { href: `${base}/${domain.slug}/`, label: 'Today', key: 'latest' },
      { href: `${base}/${domain.slug}/archive/`, label: 'Archive', key: 'archive' },
      { href: `${base}/about/`, label: 'About', key: 'about' },
    ]
  : [{ href: `${base}/about/`, label: 'About', key: 'about' }];
---
<!doctype html>
<html lang="en" data-domain={domain?.slug ?? ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171412" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={domain ? `${SITE.name} ${domain.name}` : SITE.name} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="icon" href={`${base}/icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/icons/apple-touch-icon.png`} />
    {rssHref && <link rel="alternate" type="application/rss+xml" title={`${SITE.name} ${domain!.name}`} href={rssHref} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Inter:ital,wght@0,400..700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      // Same rule as shivu.io: saved theme, else system. Applied before paint. Remember the domain for the home redirect.
      try {
        var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
        var d = document.documentElement.dataset.domain;
        if (d) localStorage.setItem('sift-domain', d);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="layout">
      <aside class="sidebar">
        <div>
          <div class="sidebar-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M7 12h10M10 17h4"/></svg>
          </div>
          <h1><a href={`${base}/`}>{SITE.name}</a></h1>
          <p class="sidebar-role">{domain ? domain.name : 'Daily digest'}</p>
          <p class="sidebar-tag">{domain ? domain.short : SITE.tagline}</p>

          <label class="field-label" for="domain-select">Field</label>
          <select id="domain-select" class="domain-select" aria-label="Choose a field">
            {!domain && <option value="" selected disabled>Choose a field</option>}
            {DOMAINS.map((d) => (
              <option value={`${base}/${d.slug}/`} selected={d.slug === domain?.slug}>{d.name}</option>
            ))}
          </select>

          <nav class="side-nav" aria-label="Section">
            <ul>
              {nav.map((n) => <li><a href={n.href} class:list={{ active: current === n.key }}>{n.label}</a></li>)}
              {rssHref && <li><a href={rssHref}>RSS</a></li>}
            </ul>
          </nav>
        </div>

        <div class="sidebar-foot">
          <ul class="social-row">
            <li><a href="https://github.com/shivaswaroop40/sift">GitHub</a></li>
            <li><a href="https://shivu.io">shivu.io</a></li>
            <li>
              <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
              </button>
            </li>
          </ul>
          <p class="colophon">Scored and summarised by a language model from public feeds. Everything links out. Nothing here is original reporting.</p>
        </div>
      </aside>

      <main class="content" id="content">
        <slot />
      </main>
    </div>
    <script is:inline>
      document.getElementById('domain-select').addEventListener('change', function (e) {
        if (e.target.value) location.href = e.target.value;
      });
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
