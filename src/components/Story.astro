---
import { render, type CollectionEntry } from 'astro:content';
import { sectionLabel } from '../lib/domains';

interface Props { entry: CollectionEntry<'stories'>; lead?: boolean }
const { entry, lead = false } = Astro.props;
const s = entry.data;
const { Content } = await render(entry);
const host = (() => { try { return new URL(s.url).hostname.replace(/^www\./, ''); } catch { return ''; } })();
const showHost = host && !s.source.toLowerCase().includes(host.split('.')[0]);
---
<article class:list={['entry', { lead }]} id={s.id}>
  <div class="entry-head">
    <h3><a href={s.url} rel="noopener">{s.title}</a></h3>
    <p class="entry-period">№ {s.rank} · {sectionLabel(s.section)}</p>
  </div>
  <p class="entry-org"><b>{s.source}</b>{showHost && ` · ${host}`}{s.authors.length > 0 && ` · ${s.authors.slice(0, 3).join(', ')}${s.authors.length > 3 ? ' et al.' : ''}`}</p>
  {s.why_read && <p class="why">{s.why_read}</p>}
  <div class="entry-body"><Content /></div>
  <div class="entry-foot">
    {s.scored ? (
      <span class="scores">depth <i>{s.depth_score}</i> · novelty <i>{s.novelty_score}</i> · utility <i>{s.utility_score}</i></span>
    ) : (
      <span title="This edition was generated without model scoring">unscored</span>
    )}
    {s.comments && <a href={s.comments} rel="noopener">discussion</a>}
  </div>
  {s.tags.length > 0 && <ul class="tags">{s.tags.map((t) => <li>{t}</li>)}</ul>}
</article>
