---
import { render, type CollectionEntry } from 'astro:content';
import { sectionLabel } from '../lib/domains';

interface Props { entry: CollectionEntry<'stories'>; lead?: boolean }
const { entry, lead = false } = Astro.props;
const s = entry.data;
const Content = lead ? (await render(entry)).Content : null;
const kind = s.kind.charAt(0).toUpperCase() + s.kind.slice(1);
---
{Content ? (
  <article class="entry lead" id={s.id}>
    <div class="lead-top">
      <div>
        <p class="label">{sectionLabel(s.section)} · No. {s.rank}</p>
        <h2><a href={s.url} rel="noopener">{s.title}</a></h2>
        {s.why_read && <p class="dek">{s.why_read}</p>}
      </div>
      <figure><slot name="plate" /></figure>
    </div>
    <div class="entry-body"><Content /></div>
    <div class="meta">
      <span>{s.source}</span>
      <span>{kind}</span>
      {s.scored ? (
        <span>Depth {s.depth_score} · Novelty {s.novelty_score} · Use {s.utility_score}</span>
      ) : (
        <span title="This edition was generated without model scoring">Unscored</span>
      )}
      {s.comments && <a href={s.comments} rel="noopener">Discussion</a>}
      <a href={s.url} rel="noopener">{s.kind === 'paper' ? 'Read the paper' : 'Read the original'}</a>
    </div>
  </article>
) : (
  <article class="entry" id={s.id}>
    <p class="label">{sectionLabel(s.section)}</p>
    <h3><a href={s.url} rel="noopener">{s.title}</a></h3>
    {s.why_read && <p class="why">{s.why_read}</p>}
    <p class="source">{s.source}</p>
  </article>
)}
