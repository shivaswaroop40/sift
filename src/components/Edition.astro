---
import type { CollectionEntry } from 'astro:content';
import Story from './Story.astro';
import { fmtDate, editionMeta, type Domain } from '../lib/domains';

interface Props { domain: Domain; date: string; stories: CollectionEntry<'stories'>[]; isLatest: boolean }
const { domain, date, stories, isLatest } = Astro.props;
const meta = await editionMeta(domain.slug, date);
---
<section class="section">
  <p class="kicker">{isLatest ? 'Today' : 'Edition'} <span>· {fmtDate(date)}{meta && ` · ${meta.kept} of ${meta.candidates} candidates`}</span></p>
  <h2 class="section-title">{domain.name}</h2>
  {meta?.dry_run && (
    <p class="notice">This edition was built without model scoring. Rankings are a placeholder and bodies are feed excerpts. The first scheduled run replaces it.</p>
  )}
  {stories.map((s, i) => <Story entry={s} lead={i === 0} />)}
</section>
