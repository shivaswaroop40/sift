---
import type { CollectionEntry } from 'astro:content';
import Story from './Story.astro';
import { editionMeta, type Domain } from '../lib/domains';

interface Props { domain: Domain; date: string; stories: CollectionEntry<'stories'>[] }
const { domain, date, stories } = Astro.props;
const meta = await editionMeta(domain.slug, date);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [lead, ...rest] = stories;
---
{meta?.dry_run && (
  <p class="notice">This edition was built without model scoring. Rankings are a placeholder and bodies are feed excerpts. The first scheduled run replaces it.</p>
)}
<section class="lead-row">
  <Story entry={lead} lead />
  <figure>
    <img class="plate" src={`${base}/${domain.cover}`} alt="" width="1200" height="686" />
  </figure>
</section>
{rest.length > 0 && (
  <section class="grid" aria-label="More stories">
    {rest.map((s) => <Story entry={s} />)}
  </section>
)}
